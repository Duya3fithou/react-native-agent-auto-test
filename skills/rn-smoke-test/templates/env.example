# Test data for the Maestro flows. Copy to .env (same folder) and fill in.
# .env is git-ignored. Flows read these as ${VAR}; never hard-code credentials in a flow.
# APP_ID and PLATFORM are injected automatically by `rnsmoke run`.

# ONE dedicated test account on a dev/staging backend (already registered; logged-out state comes from
# clearState). This is the only account a smoke session may use or change - rnsmoke ignores any other
# account variable (TEST_EMAIL_2, ADMIN_PASSWORD, ...) and never creates accounts.
TEST_EMAIL=
TEST_PASSWORD=

# Facility / tenant / environment the onboarding asks for (if any)
TEST_FACILITY=

